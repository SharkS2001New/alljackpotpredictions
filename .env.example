# AllJackpotPredictions — copy to .env for local only (never commit secrets)
#
# Local: keep APP_URL on 127.0.0.1 (or your ./serve port).
# Production (k3s): DB_* / APP_URL / Redis come from Helm values / alljackpotpredictions-env.
# Helm redisEnv injects CACHE_DRIVER=redis + REDIS_HOST/PASSWORD automatically.

APP_ENV=local
APP_NAME="AllJackpotPredictions"
APP_URL=http://127.0.0.1:5001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pitchnewdb
DB_USERNAME=
DB_PASSWORD=

# —— Same Redis contract as baopredictions / pitchpredictionsbackend ——
# Local default: file. Production k3s forces CACHE_DRIVER=redis via Helm.
CACHE_DRIVER=file
CACHE_PREFIX=ajp_cache_
REDIS_PREFIX=ajp_database_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Optional TTLs (seconds)
# Stats: 24h — ticker/sidebar numbers change slowly; warm-cache refreshes daily
CACHE_TTL_STATS=86400
# Tip boards
CACHE_TTL_TODAY=600
CACHE_TTL_TOMORROW=3600
CACHE_TTL_JACKPOT=600
# CACHE_TTL_WEEKEND=18000
# CACHE_TTL_PAST=43200

PITCH_API_URL=https://api.pitchpredictions.com
ACCESS_TOKEN=

# Jackpot sheet API (Origin header). Production sets this via Helm.
JACKPOT_API_ORIGIN=https://www.alljackpotpredictions.com
# JACKPOT_API_KEY=
